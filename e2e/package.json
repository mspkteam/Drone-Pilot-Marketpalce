{
  "name": "drone-pilot-marketplace-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Isolated Playwright E2E suite for Remote Air Service",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "HEADED=1 E2E_WORKERS=1 E2E_PAUSE_AFTER_TEST_MS=2500 playwright test --project=chromium --headed --workers=1",
    "test:headed:interactive": "bash scripts/run-headed-interactive.sh",
    "explore": "tsx exploration/explore.ts",
    "explore:headed": "HEADED=1 tsx exploration/explore.ts",
    "report": "playwright show-report playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.0.0",
    "dotenv": "^16.6.1",
    "tsx": "^4.20.3",
    "typescript": "^5.0.0"
  }
}
