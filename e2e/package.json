    "report": "playwright show-report playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "1.52.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.6.1",
    "tsx": "^4.20.3",
    "typescript": "^5.0.0"
  }
}
