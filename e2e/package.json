{
  "name": "drone-pilot-marketplace-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Isolated Playwright E2E suite for Remote Air Service",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "HEADED=1 playwright test --project=chromium --headed",
