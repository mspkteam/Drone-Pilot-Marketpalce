# Database
# Local dev + internal Vercel demo: SQLite
DATABASE_URL="file:./dev.db"
# Production / staging (Neon): pooled connection string from Neon dashboard
# DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Vercel demo: set AUTH_URL to your deployment URL (e.g. https://your-app.vercel.app)
# AUTH_URL="https://your-domain.com"

# Email: leave SMTP_URL unset — demo logs to console only (no real SMTP)
# SMTP_URL=
# EMAIL_FROM=noreply@dronepilot.local

# Payments: no Stripe keys — marketplace and shop use internal demo pay only
