{
  "name": "drone-pilot-marketplace",
  "version": "0.27.45",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:all",
    "test:all": "tsx --test src/lib/**/*.test.ts src/lib/**/**/*.test.ts",
    "test:qa": "npm run test:all",
    "security:check": "tsx --test src/lib/security/api-route-auth.test.ts src/lib/security/repo-security.test.ts",
    "qa": "node scripts/qa-security-check.mjs",
    "screenshots:mobile": "node scripts/mobile-screenshots.mjs",
    "postinstall": "prisma generate",
    "db:setup": "prisma generate && prisma db push && prisma db seed",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "waitlist:backfill-sheet": "tsx scripts/backfill-waitlist-sheet.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.6.1",
    "lucide-react": "^1.23.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "pdfkit": "^0.18.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "archiver": "^7.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.52.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
