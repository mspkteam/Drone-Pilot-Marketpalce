# Local development (default — no Neon required)
# Copy this file to `.env` and adjust as needed.

USE_LOCAL_DB=1
DATABASE_URL="file:./prisma/dev.db"
DIRECT_URL="file:./prisma/dev.db"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"

# --- Neon (when you connect a remote database later) ---
# 1. In prisma/schema.prisma set: provider = "postgresql"
# 2. Uncomment and fill in Neon URLs (see docs/NEON_SETUP.md)
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Weekly frontend lock (see src/lib/milestones.ts + src/lib/public-access.ts) ---
# Dashboard features unlock by week (1–5). Backend may be ahead of the visible UI.
NEXT_PUBLIC_MILESTONE_ACTIVE=1
# Comma-separated marketing paths visible to the public (auth routes always open):
# NEXT_PUBLIC_UNLOCKED_PUBLIC_PATHS="/,/for-clients,/how-it-works"
# AUTH_URL="https://your-app.vercel.app"

# Email: leave SMTP_URL unset — demo logs to console only (no real SMTP)
# SMTP_URL=
# EMAIL_FROM=noreply@dronepilot.local

# Pre-launch waitlist landing (separate Vercel deploy posts to this API)
# Comma-separated origins allowed for POST /api/waitlist (e.g. https://join.remoteairservice.com)
# WAITLIST_ALLOWED_ORIGINS="https://join.remoteairservice.com,http://localhost:3001"
# Waitlist → Google Sheet via Make.com (recommended)
# WAITLIST_MAKE_WEBHOOK_URL="https://hook.us1.make.com/xxxxxxxx"
# Legacy Google Apps Script fallback:
# WAITLIST_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/.../exec"
# Backfill existing rows: npm run waitlist:backfill-sheet
# Cloudflare Turnstile (spam protection on waitlist forms)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA..."
# TURNSTILE_SECRET_KEY="0x4AAAAAAA..."

# Payments: no Stripe keys — marketplace and shop use internal demo pay only
