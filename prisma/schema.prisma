// Drone Pilot Marketplace — see docs/DATA_MODEL_OVERVIEW.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  role            String
  status          String         @default("active")
  /// Platform RAS member number (6 digits, starts at 001000). Pilots and clients.
  memberNumber    String?        @unique
  /// Admin note when account is held for review / ToS (not shown to the user).
  moderationNote  String?
  emailVerifiedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  pilotProfile    PilotProfile?
  clientProfile   ClientProfile?
  reviewsWritten       Review[]
  notifications        Notification[]
  messagesSent         Message[]
  conversationReadStates ConversationReadState[]
  disputesOpened       Dispute[]       @relation("DisputeOpenedBy")
  disputesReviewed     Dispute[]       @relation("DisputeReviewedBy")
  disputesResolved     Dispute[]       @relation("DisputeResolvedBy")
  disputeEntries       DisputeEntry[]
  uniformOrders        UniformOrder[]
  supportChatsRequested SupportChat[]     @relation("SupportChatRequester")
  supportChatsAssigned  SupportChat[]     @relation("SupportChatAssigned")
  supportMessagesSent   SupportChatMessage[]
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  channel   String    @default("in_app")
  title     String
  body      String
  payload   String?
  status    String    @default("sent")
  readAt    DateTime?
  sentAt    DateTime  @default(now())
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, readAt])
}

model PilotProfile {
  id                    String              @id @default(cuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String
  bio                   String?
  locationCity          String?
  locationRegion        String?
  locationCountry       String?
  serviceRadiusKm       Int?
  servicesOffered       String              @default("[]")
  portfolioJson         String              @default("[]")
  /// JSON: call sign, languages, drones, payloads, extra service chips, avatar (see lib/pilot/profile-extras.ts)
  profileExtrasJson     String              @default("{}")
  hourlyRateMin         Float?
  hourlyRateMax         Float?
  licenseNumber         String
  licenseCountry        String?
  isPublic              Boolean             @default(false)
  status                String              @default("draft")
  /** Demo instructor add-on flag until Stripe (M316). */
  instructorAddonActive Boolean             @default(false)
  instructorAddonPeriodEnd DateTime?
  instructorDiscountCode String?            @unique
  referredByInstructorId String?
  referredByInstructor   PilotProfile?      @relation("InstructorStudents", fields: [referredByInstructorId], references: [id], onDelete: SetNull)
  instructorStudents     PilotProfile[]     @relation("InstructorStudents")
  instructorWingRequests InstructorWingRequest[] @relation("InstructorWingRequests")
  studentWingRequests    InstructorWingRequest[] @relation("StudentWingRequests")
  aviatorWingRequests    AviatorWingRequest[]
  complianceAcceptedAt  DateTime?
  onboardingCompletedAt DateTime?
  commissionOverrideEnabled   Boolean   @default(false)
  commissionOverrideRate      Float?
  commissionOverrideReason    String?
  commissionOverrideEffective String?
  commissionOverrideUpdatedAt DateTime?
  commissionOverrideSetById   String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  applications          JobApplication[]
  bookings              Booking[]
  reviewsReceived       Review[]            @relation("ReviewsForPilot")
  subscriptions         PilotSubscription[]
  verifications         Verification[]
  conversationsAsPilot  Conversation[] @relation("PilotConversations")
  certificates          PilotCertificate[]
  wings                 PilotWing[]
}

model Verification {
  id               String       @id @default(cuid())
  pilotProfileId   String
  pilotProfile     PilotProfile @relation(fields: [pilotProfileId], references: [id], onDelete: Cascade)
  type             String
  documentUrl      String?
  documentFileName String?
  documentMimeType String?
  originalFileName String?
  notes            String?
  status           String       @default("pending")
  submittedAt      DateTime     @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  rejectionReason  String?
  expiresAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([pilotProfileId])
  @@index([status])
  @@index([pilotProfileId, type, status])
}

model ClientProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName           String?
  contactName           String
  phone                 String?
  billingAddress        String?
  /// JSON: extended profile fields + notification preferences (see lib/client/preferences.ts)
  preferencesJson       String?
  status                String    @default("draft")
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  jobs                  Job[]
  bookings              Booking[]
  reviewsReceived       Review[]         @relation("ReviewsForClient")
  conversationsAsClient Conversation[]   @relation("ClientConversations")
}

model Job {
  id               String           @id @default(cuid())
  clientProfileId  String
  clientProfile    ClientProfile    @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  title            String
  description      String
  category         String
  locationLabel    String
  locationCity     String?
  locationRegion   String?
  locationCountry  String?
  scheduledDate    DateTime?
  budgetMin        Float?
  budgetMax        Float?
  currency         String           @default("USD")
  requirements     String?
  /// Structured wizard payload from post-project flow (see lib/jobs/post-project-metadata.ts)
  postProjectJson  String?
  status           String           @default("draft")
  rejectionReason  String?
  approvedAt       DateTime?
  approvedByUserId String?
  submittedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  applications     JobApplication[]
  booking          Booking?
  conversations    Conversation[]

  @@index([clientProfileId])
  @@index([status])
}

model JobApplication {
  id                    String       @id @default(cuid())
  jobId                 String
  job                   Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  pilotProfileId        String
  pilotProfile          PilotProfile @relation(fields: [pilotProfileId], references: [id], onDelete: Cascade)
  proposedAmount        Float
  currency              String       @default("USD")
  message               String?
  estimatedDeliveryDate DateTime?
  proposalDetailsJson   String?
  status                String       @default("submitted")
  shortlistedAt         DateTime?
  submittedAt           DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  booking               Booking?
  conversation          Conversation?

  @@unique([jobId, pilotProfileId])
  @@index([jobId])
  @@index([pilotProfileId])
}

model Booking {
  id                String         @id @default(cuid())
  jobId             String         @unique
  job               Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobApplicationId  String         @unique
  jobApplication    JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  pilotProfileId    String
  pilotProfile      PilotProfile   @relation(fields: [pilotProfileId], references: [id], onDelete: Cascade)
  clientProfileId   String
  clientProfile     ClientProfile  @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  agreedAmount      Float
  currency          String         @default("USD")
  status            String         @default("pending")
  scheduledStartAt  DateTime?
  scheduledEndAt    DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  reviews           Review[]
  payment           Payment?
  commission        Commission?
  conversation      Conversation?
  dispute           Dispute?
  delivery          BookingDelivery?

  @@index([pilotProfileId])
  @@index([clientProfileId])
  @@index([status])
}

model BookingDelivery {
  id             String    @id @default(cuid())
  bookingId      String    @unique
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status         String    @default("draft")
  notes          String?
  filesJson      String?
  clientFeedback String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

model Dispute {
  id               String          @id @default(cuid())
  bookingId        String          @unique
  booking          Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  openedByUserId   String
  openedByUser     User            @relation("DisputeOpenedBy", fields: [openedByUserId], references: [id], onDelete: Cascade)
  openedByRole     String
  status           String          @default("open")
  reason           String
  resolutionType   String?
  resolutionAmount Float?
  resolutionNotes  String?
  reviewedByUserId String?
  reviewedByUser   User?           @relation("DisputeReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  resolvedByUserId String?
  resolvedByUser   User?           @relation("DisputeResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  entries          DisputeEntry[]
  squadronBallot   SquadronBallot?

  @@index([status])
  @@index([openedByUserId])
  @@index([createdAt])
}

model ModeratorPermissionRecord {
  id              String   @id @default(cuid())
  userId          String   @unique
  preset          String
  permissionsJson String
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([preset])
}

/** Append-only history of Super Admin permission map changes (M284). */
model ModeratorPermissionAuditLog {
  id             String   @id @default(cuid())
  targetUserId   String
  actorUserId    String
  previousPreset String
  newPreset      String
  previousJson   String
  newJson        String
  createdAt      DateTime @default(now())

  @@index([targetUserId])
  @@index([actorUserId])
  @@index([createdAt])
}

model CmsArticleRecord {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String
  body            String
  featuredImage   String?
  category        String
  tagsJson        String    @default("[]")
  audience        String    @default("public")
  status          String    @default("draft")
  featured        Boolean   @default(false)
  author          String
  readTimeMinutes Int       @default(3)
  publishedAt     DateTime?
  seoTitle        String
  seoDescription  String
  ogImage         String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model CmsResourceRecord {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  resourceType    String
  summary         String
  body            String
  featuredImage   String?
  fileUrl         String?
  externalUrl     String?
  category        String
  tagsJson        String    @default("[]")
  audience        String    @default("public")
  status          String    @default("draft")
  featured        Boolean   @default(false)
  downloadCtaLabel String   @default("Download")
  publishedAt     DateTime?
  seoTitle        String
  seoDescription  String
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueJson String
  updatedAt DateTime @updatedAt
}

model OperatingRegion {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  timezone  String   @default("UTC")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model SquadronBallot {
  id             String    @id @default(cuid())
  disputeId      String    @unique
  dispute        Dispute   @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  status         String    @default("open")
  recommendation String?
  votesJson      String    @default("[]")
  openedByUserId String?
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

model DisputeEntry {
  id            String   @id @default(cuid())
  disputeId     String
  dispute       Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorUserId  String
  authorUser    User     @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  entryType     String
  body          String
  attachmentUrl String?
  createdAt     DateTime @default(now())

  @@index([disputeId])
  @@index([authorUserId])
  @@index([createdAt])
}

model Conversation {
  id               String         @id @default(cuid())
  jobId            String
  job              Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobApplicationId String         @unique
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  bookingId        String?        @unique
  booking          Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  clientProfileId  String
  clientProfile    ClientProfile  @relation("ClientConversations", fields: [clientProfileId], references: [id], onDelete: Cascade)
  pilotProfileId   String
  pilotProfile     PilotProfile   @relation("PilotConversations", fields: [pilotProfileId], references: [id], onDelete: Cascade)
  lastMessageAt    DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  messages         Message[]
  readStates       ConversationReadState[]

  @@index([clientProfileId])
  @@index([pilotProfileId])
  @@index([jobId])
  @@index([lastMessageAt])
}

model ConversationReadState {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  senderUser     User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderUserId])
  @@index([createdAt])
}

model Payment {
  id                String      @id @default(cuid())
  bookingId         String      @unique
  booking           Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payerUserId       String
  payeeUserId       String
  amountGross       Float
  amountNet         Float
  currency          String      @default("USD")
  provider          String      @default("internal")
  providerPaymentId String?
  status            String      @default("succeeded")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  commission        Commission?

  @@index([payerUserId])
  @@index([payeeUserId])
}

model Commission {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentId     String?   @unique
  payment       Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  rate          Float     @default(0.1)
  amount        Float
  currency      String    @default("USD")
  status        String    @default("calculated")
  calculatedAt  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Review {
  id                    String         @id @default(cuid())
  bookingId             String
  booking               Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorUserId          String
  authorUser            User           @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  targetPilotProfileId  String?
  targetPilotProfile    PilotProfile?  @relation("ReviewsForPilot", fields: [targetPilotProfileId], references: [id], onDelete: Cascade)
  targetClientProfileId String?
  targetClientProfile   ClientProfile? @relation("ReviewsForClient", fields: [targetClientProfileId], references: [id], onDelete: Cascade)
  rating                Int
  comment               String?
  status                String         @default("published")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([bookingId, authorUserId])
  @@index([targetPilotProfileId])
  @@index([targetClientProfileId])
  @@index([authorUserId])
}

model SubscriptionPlan {
  id                      String              @id @default(cuid())
  code                    String?             @unique
  name                    String
  slug                    String              @unique
  priceMonthly            Float               @default(0)
  priceYearly             Float               @default(0)
  jobVisibilityDelayHours Int                 @default(0)
  canViewJobs             Boolean             @default(true)
  canApply                Boolean             @default(false)
  instructorEligible      Boolean             @default(false)
  sortOrder               Int                 @default(0)
  currency                String              @default("USD")
  features                String              @default("[]")
  isActive                Boolean             @default(true)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  subscriptions           PilotSubscription[]

  @@index([isActive])
  @@index([sortOrder])
}

model PilotSubscription {
  id                     String           @id @default(cuid())
  pilotProfileId         String
  pilotProfile           PilotProfile     @relation(fields: [pilotProfileId], references: [id], onDelete: Cascade)
  subscriptionPlanId     String
  subscriptionPlan       SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id], onDelete: Restrict)
  status                 String           @default("active")
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  externalSubscriptionId String?
  instructorDiscountCode String?
  instructorDiscountUsd  Float            @default(0)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([pilotProfileId])
  @@index([status])
}

model WaitlistEntry {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  roleInterest String
  region       String?
  source       String?
  status       String   @default("subscribed")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([roleInterest])
  @@index([createdAt])
}

model CertificateTemplate {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  description          String?
  title                String
  bodyTemplate         String
  backgroundImageUrl   String?
  layoutKey            String?
  /** JSON array of { field, x, y, font, ... } percent overrides for drag-aligned overlays. */
  overlayPositionsJson String?
  /** Auto-issue rule — see CERTIFICATE_AUTO_RULES (manual_only default). */
  autoRule             String             @default("manual_only")
  ruleParam            String?
  threshold            Int?
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  certificates         PilotCertificate[]
}

model PilotCertificate {
  id                String              @id @default(cuid())
  certificateNumber String              @unique
  pilotProfileId    String
  pilotProfile      PilotProfile        @relation(fields: [pilotProfileId], references: [id], onDelete: Cascade)
  templateId        String
  template          CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  pilotDisplayName  String
  licenseNumber     String?
  awardGrade        String?
  issuedAt          DateTime            @default(now())
  issuedByUserId    String
  pdfFileName       String
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([pilotProfileId])
  @@index([templateId])
  @@index([issuedAt])
}

model WingDefinition {
  id          String      @id @default(cuid())
  code        String      @unique
  title       String
  description String
  category    String      @default("milestone")
  /** COMMON | UNCOMMON | RARE | EPIC | LEGENDARY | MYTHIC */
  rarity      String      @default("COMMON")
  iconLabel   String?
  imageUrl    String?
  autoRule    String?
  ruleParam   String?
  threshold   Int?
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  pilotWings  PilotWing[]

  @@index([isActive])
  @@index([sortOrder])
  @@index([rarity])
}

model PilotWing {
  id               String         @id @default(cuid())
  pilotProfileId   String
  pilotProfile     PilotProfile   @relation(fields: [pilotProfileId], references: [id], onDelete: Cascade)
  wingDefinitionId String
  wingDefinition   WingDefinition @relation(fields: [wingDefinitionId], references: [id], onDelete: Cascade)
  source           String         @default("auto")
  assignedByUserId String?
  earnedAt         DateTime       @default(now())
  metadata         String?

  @@unique([pilotProfileId, wingDefinitionId])
  @@index([pilotProfileId])
  @@index([earnedAt])
}

/** Admin-reviewed aviator wing requests (Figma Request Wings). Distinct from instructor student awards. */
model AviatorWingRequest {
  id               String       @id @default(cuid())
  pilotProfileId   String
  pilotProfile     PilotProfile @relation(fields: [pilotProfileId], references: [id], onDelete: Cascade)
  wingCode         String
  status           String       @default("draft")
  legalName        String       @default("")
  ftn              String?
  totalHours       Float?
  notes            String?
  confirmation     Boolean      @default(false)
  documentsJson    String       @default("{}")
  rejectionReason  String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedByUserId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([pilotProfileId, status])
  @@index([status])
  @@index([createdAt])
}

/** Student wing requests reviewed by an active Remote Pilot Instructor. */
model InstructorWingRequest {
  id                 String       @id @default(cuid())
  instructorProfileId String
  instructorProfile  PilotProfile @relation("InstructorWingRequests", fields: [instructorProfileId], references: [id], onDelete: Cascade)
  studentProfileId   String
  studentProfile     PilotProfile @relation("StudentWingRequests", fields: [studentProfileId], references: [id], onDelete: Cascade)
  wingCode           String
  status             String       @default("pending")
  instructorNote     String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  resolvedAt         DateTime?

  @@index([instructorProfileId, status])
  @@index([studentProfileId])
  @@index([createdAt])
}

model UniformProduct {
  id          String                   @id @default(cuid())
  name        String
  slug        String                   @unique
  description String
  imageUrl    String?
  isActive    Boolean                  @default(true)
  sortOrder   Int                      @default(0)
  /// Minimum membership tier code (e.g. A6_CAPTAIN). Null = no minimum.
  minTierCode String?
  /// Exact membership tier required (e.g. epaulettes for that grade only).
  exactTierCode String?
  /// WingDefinition.code the pilot must already hold to see/order this item.
  requiredWingCode String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  variants    UniformProductVariant[]
  images      UniformProductImage[]

  @@index([isActive])
  @@index([sortOrder])
}

model UniformProductImage {
  id        String         @id @default(cuid())
  productId String
  product   UniformProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([productId])
  @@index([sortOrder])
}

model UniformProductVariant {
  id            String             @id @default(cuid())
  productId     String
  product       UniformProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String             @unique
  label         String
  size          String?
  color         String?
  price         Float
  stockQuantity Int                @default(0)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  orderItems    UniformOrderItem[]

  @@index([productId])
  @@index([isActive])
}

model UniformOrder {
  id              String             @id @default(cuid())
  orderNumber     String             @unique
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String             @default("pending_payment")
  paymentStatus   String             @default("pending")
  currency        String             @default("USD")
  subtotal        Float
  shippingAmount  Float              @default(0)
  total           Float
  shippingName    String
  shippingLine1   String
  shippingLine2   String?
  shippingCity    String
  shippingRegion  String?
  shippingPostal  String
  shippingCountry String             @default("United States")
  shippingPhone   String?
  notes           String?
  placedAt        DateTime           @default(now())
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  items           UniformOrderItem[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
}

model UniformOrderItem {
  id           String                @id @default(cuid())
  orderId      String
  order        UniformOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String
  variant      UniformProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName  String
  variantLabel String
  sku          String
  unitPrice    Float
  quantity     Int
  lineTotal    Float

  @@index([orderId])
  @@index([variantId])
}

model SupportChat {
  id               String               @id @default(cuid())
  requesterUserId  String?
  requesterUser    User?                @relation("SupportChatRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  guestToken       String?              @unique
  requesterRole    String
  requesterName    String
  requesterEmail   String
  subject          String?
  initialMessage   String
  status           String               @default("open")
  assignedAdminId  String?
  assignedAdmin    User?                @relation("SupportChatAssigned", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  lastMessageAt    DateTime             @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  messages         SupportChatMessage[]

  @@index([requesterUserId])
  @@index([requesterEmail])
  @@index([status])
  @@index([lastMessageAt])
}

model SupportChatMessage {
  id                 String      @id @default(cuid())
  supportChatId      String
  supportChat        SupportChat @relation(fields: [supportChatId], references: [id], onDelete: Cascade)
  senderUserId       String?
  senderUser         User?       @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  senderRole         String
  senderName         String
  message            String
  attachmentUrl      String?
  attachmentFileName String?
  attachmentMimeType String?
  isSystem           Boolean     @default(false)
  createdAt          DateTime    @default(now())

  @@index([supportChatId])
  @@index([createdAt])
}
